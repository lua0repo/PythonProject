def main():
    histories = {}
    for tn in TYPE_CONFIG:
        if tn in CSV_PATHS:
            histories[tn] = load_csv(CSV_PATHS[tn])
        elif tn in data_types:
            d = data_types[tn]
            histories[tn] = [d[k] for k in sorted(d, key=set_key_num)]

    for tn, draws in histories.items():
        for p in validate_draws(tn, draws):
            print(f"DATA FLAG {tn}: {p}")
        if len(draws) < MIN_HISTORY + TRIAL_FLOOR:
            print(f"NOTE {tn}: {len(draws)} draws loaded - looks like sample/demo data; "
                  f"backtest needs {MIN_HISTORY + TRIAL_FLOOR}+.")

    for tn, draws in histories.items():
        all_type_predictions[tn] = analyze_type(tn, as_dict(draws))

    stats = run_validation(histories) if RUN_BACKTEST else {}
    if not RUN_BACKTEST:
        print("\nBACKTEST SKIPPED (RUN_BACKTEST = False): every pick is unvalidated.")

    print("\n" + "=" * 70)
    print("SELECTION (validated picks only count as 'best')")
    print("=" * 70)
    for tn, picks in all_type_predictions.items():
        if picks:
            find_best(tn, picks, stats)

    for tn, res in RESULTS.items():
        if tn not in all_type_predictions or not res:
            continue
        cfg = TYPE_CONFIG[tn]
        print(f"\n=== RESULT CHECK {tn}: {res} (scored after picking; never added to history) ===")
        for m, p in all_type_predictions[tn].items():
            print(f"  {m:<22} {score_pick(p, res, cfg)} match(es)")
        pk = null_distribution(cfg)
        print(f"  Random ticket expectation: {(pk * np.arange(len(pk))).sum():.2f}. One draw proves nothing.")

    if RUN_DEEP_LEARNING:
        last = list(histories)[-1]
        run_deep_learning(last, histories[last], all_type_predictions.get(last, {}))

    print(f"\n✅ Script completed.")

