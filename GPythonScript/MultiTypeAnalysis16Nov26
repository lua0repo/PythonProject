def analyze_type(type_name, historical_data):
    random.seed(SEED)
    np.random.seed(SEED)
    cfg = TYPE_CONFIG[type_name]

    print("\n" + "="*50)
    print(f"PROCESSING DATA TYPE: {type_name} - {cfg['name']}")
    print("="*50)

    DISABLE_SORTING = cfg["positional"]
    if DISABLE_SORTING:
        print("⚠️  SORTING DISABLED FOR THIS TYPE - Preserving original order")

    set_names = list(historical_data.keys())
    all_sets = list(historical_data.values())
    if not all_sets:
        print("No data available.")
        return {}

    n_balls = cfg["n_slots"]
    if not all(len(s) == n_balls for s in all_sets):
        print("Inconsistent set lengths.")
        return {}

    all_nums_flat = [num for nums in all_sets for num in nums]
    # FIX: range from the game, not from the loaded draws
    min_number = cfg["min_val"]
    max_number = cfg["max_val"]

    num_segments = min(6, max_number - min_number + 1)
    segment_size = (max_number - min_number + 1) // num_segments
    segments_bounds = []
    current = min_number
    for i in range(num_segments):
        end = current + segment_size - 1 if i < num_segments - 1 else max_number
        segments_bounds.append((current, end))
        current = end + 1

    def prepare_dataframe(data_dict):
        df = pd.DataFrame(data_dict).T
        df.columns = [f"Ball_{i+1}" for i in range(len(df.columns))]
        return df

    class DifferencePredictor:
        def __init__(self, dataframe):
            self.df = dataframe
            self.diff_df = self.compute_differences()
            self.regime_engine = AdaptiveRegimeEngine(window=15, n_balls=n_balls)

        def compute_differences(self):
            diff_df = self.df.diff().iloc[1:]
            diff_df.index = [f"{prev} -> {curr}" for prev, curr in zip(self.df.index[:-1], self.df.index[1:])]
            return diff_df

        def display_differences(self):
            print("-" * 40)
            print("DIFFERENCES BETWEEN CONSECUTIVE SETS")
            print("-" * 40)
            true_history_diff = self.diff_df.copy()
            predicted_diff = self.predict_diffs_regression()
            self.diff_df.loc['ML PREDICTION'] = predicted_diff
            highest_counts = []
            for col in self.diff_df.columns:
                mode_val = self.diff_df[col].mode()
                highest_counts.append(mode_val.iloc[0] if not mode_val.empty else np.nan)
            self.diff_df.loc['HIGHEST COUNT'] = highest_counts
            print(self.diff_df.to_string())

            last_set = [int(x) for x in self.df.iloc[-1].tolist()]
            pre_Deff_set = [max(min_number, min(max_number, last_set[i] + predicted_diff[i])) for i in range(n_balls)]
            if not DISABLE_SORTING:
                pre_Deff_set = sorted(pre_Deff_set)

            print("\nPredicted Difference from Last SET (ML Regression) =>", ' '.join(map(str, predicted_diff)))
            print("Predicted SET_N =>", pre_Deff_set)
            print(f"✅Reusable pre_Deff_set: {pre_Deff_set}")
            if len(true_history_diff) >= 2:
                self.regime_engine.run_analysis(true_history_diff)
            return pre_Deff_set

        def predict_diffs_regression(self):
            predicted_diff = []
            time_steps = list(range(1, len(self.diff_df) + 1))
            for col in self.diff_df.columns:
                y = self.diff_df[col].tolist()
                model = CustomLinearRegression()
                model.fit(time_steps, y)
                predicted_diff.append(int(round(model.predict(len(time_steps) + 1))))
            return predicted_diff

    df = prepare_dataframe(historical_data)
    predictor_model = DifferencePredictor(df)
    pre_Deff_set = predictor_model.display_differences()

    # -------------------------------
    # EVEN/ODD ANALYSIS
    # -------------------------------
    print("\n" + "-" * 40)
    print("EVEN And ODD Details")
    print("-" * 40)
    print("Set Name Even# Odd# ET# OT#")
    total_even = total_odd = total_et = total_ot = 0
    even_odd_profiles, even_counts, odd_counts, et_sums, ot_sums = [], [], [], [], []

    for name, numbers in historical_data.items():
        evens = [n for n in numbers if n % 2 == 0]
        odds = [n for n in numbers if n % 2 != 0]
        even_sum, odd_sum = sum(evens), sum(odds)
        total_even += len(evens); total_odd += len(odds)
        total_et += even_sum; total_ot += odd_sum
        even_odd_profiles.append([len(evens), len(odds), even_sum, odd_sum])
        even_counts.append(len(evens)); odd_counts.append(len(odds))
        et_sums.append(even_sum); ot_sums.append(odd_sum)
        print(f"{name:<10} {len(evens):<7} {len(odds):<6} {even_sum:<6} {odd_sum:<6}")

    num_sets = len(all_sets)
    time_steps = list(range(1, num_sets + 1))

    def reg_next(vals):
        r = CustomLinearRegression()
