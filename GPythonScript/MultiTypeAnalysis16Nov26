# OPTIONAL DEEP LEARNING (UNVALIDATED)
# ===============================================
def run_deep_learning(type_name, draws, final_picks):
    cfg = TYPE_CONFIG[type_name]
    try:
        import tensorflow as tf
        from tensorflow.keras.models import Sequential
        from tensorflow.keras.layers import LSTM, GRU, Dense, Dropout
        from sklearn.preprocessing import MinMaxScaler
    except ImportError:
        print("TensorFlow not available. Install: pip install tensorflow scikit-learn")
        return
    tf.random.set_seed(SEED)
    n = cfg["n_slots"]
    seq = np.array(draws, dtype=np.float32)
    if len(seq) < 4:
        print("Not enough data for deep learning (need at least 4 sets)")
        return
    lookback = min(3, len(seq) - 1)
    X = np.array([seq[i:i+lookback] for i in range(len(seq) - lookback)])
    y = np.array([seq[i+lookback] for i in range(len(seq) - lookback)])
    sc = MinMaxScaler().fit(seq)
    Xs = sc.transform(X.reshape(-1, n)).reshape(X.shape)
    ys = sc.transform(y)
    preds = {}
    for name, Layer in (("LSTM", LSTM), ("GRU", GRU)):
        m = Sequential([Layer(64, return_sequences=True, input_shape=(lookback, n)), Dropout(0.3),
                        Layer(32), Dropout(0.3), Dense(32, activation='relu'), Dense(n)])
        m.compile(optimizer='adam', loss='mse')
        m.fit(Xs, ys, epochs=50, batch_size=min(16, len(Xs)), verbose=0)
        raw = sc.inverse_transform(m.predict(sc.transform(seq[-lookback:]).reshape(1, lookback, n), verbose=0)).flatten()
        fallback = sorted(range(cfg["min_val"], cfg["max_val"] + 1), key=lambda v: (-sum(d.count(v) for d in draws), v))
        preds[name] = finalize_pick(list(raw), cfg, fallback)
    print("\n" + "=" * 70)
    print(f"DEEP LEARNING ({type_name}) - UNVALIDATED: not walk-forward tested")
    print("=" * 70)
    for k, v in preds.items():
        print(f"{k:<6} -> {v}")


