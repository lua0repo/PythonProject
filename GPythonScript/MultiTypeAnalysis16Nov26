    class LagMemoryEngine:
        def __init__(self, raw_data):
            self.raw_data = raw_data
            # FIX: numeric sort (string sort put SET_10 before SET_9)
            self.set_ids = sorted([k for k in raw_data if k.startswith("SET_")], key=set_key_num)
            # FIX: ranges follow this game's segments
            self.ranges = [f"{a}–{b}" for a, b in segments_bounds] + ["Unknown"]
            self.lag_buckets = {"Lag 1": 0, "Lag 2": 0, "Lag 3": 0, "Lag 4": 0, "Lag 5+": 0}
            self.range_freq = {r: 0 for r in self.ranges}
            self.range_persistence = {r: 0 for r in self.ranges}
            self.memory_scores = {}

        def _get_range(self, val):
            for a, b in segments_bounds:
                if a <= val <= b:
                    return f"{a}–{b}"
            return "Unknown"

        def _extract_lag(self, map_str, current_set_id):
            match = re.search(r'SET_(\d+)', map_str)
            if match:
                lag = current_set_id - int(match.group(1))
                if lag == 1: return "Lag 1"
                elif lag == 2: return "Lag 2"
                elif lag == 3: return "Lag 3"
                elif lag == 4: return "Lag 4"
            return "Lag 5+"

        def process_data(self):
            for sid in self.set_ids:
                set_id = set_key_num(sid)
                elements = self.raw_data[sid]
                map_data = self.raw_data[f"MAP_{sid}"]
                raw_score = 0.0
                l1 = l2 = l3 = l4 = l5 = 0
                ranges_here = set()
                for i, map_str in enumerate(map_data):
                    lag_key = self._extract_lag(map_str, set_id)
                    if lag_key == "Lag 1": raw_score += 1.0; l1 += 1
                    elif lag_key == "Lag 2": raw_score += 0.7; l2 += 1
                    elif lag_key == "Lag 3": raw_score += 0.4; l3 += 1
                    elif lag_key == "Lag 4": raw_score += 0.2; l4 += 1
                    else: raw_score += 0.2; l5 += 1
                    self.lag_buckets[lag_key] += 1
                    r = self._get_range(elements[i])
                    self.range_freq[r] += 1
                    ranges_here.add(r)
                for r in ranges_here:
                    self.range_persistence[r] += 1
                final_score = round((raw_score / n_balls) * 100, 1)
                if final_score <= 25: cls = "Random / Reset"
                elif final_score <= 50: cls = "Mixed Memory"
                elif final_score <= 75: cls = "Stable Memory"
                else: cls = "Strong Anchored"
