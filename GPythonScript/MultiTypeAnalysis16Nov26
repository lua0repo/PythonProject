# SELF-TEST: planted controls for the validation layer
# ===============================================
def selftest():
    global MAX_TRIALS
    saved = MAX_TRIALS
    MAX_TRIALS = 80
    rng = np.random.default_rng(7)
    ok = True

    print("### NULL CONTROL (Type8, 100 random draws): expect nothing to clear")
    null = [sorted(int(x) for x in rng.choice(58, 6, replace=False) + 1) for _ in range(100)]
    s = run_validation({"Type8": null})
    n_clear = sum(r["cleared"] for r in s.get("Type8", {}).values())
    print(f"=> {n_clear} cleared -> {'PASS' if n_clear == 0 else 'FAIL'}")
    ok &= n_clear == 0

    print("\n### POSITIVE CONTROL (Type8, 100 draws, 3 balls always from {7,21,33,48,52,55}): expect 'Top Hot' to clear")
    fav = [7, 21, 33, 48, 52, 55]
    rig = []
    for _ in range(100):
        a = [int(x) for x in rng.choice(fav, 3, replace=False)]
        b = [int(x) for x in rng.choice([v for v in range(1, 59) if v not in a], 3, replace=False)]
        rig.append(sorted(a + b))
    s = run_validation({"Type8": rig})
    hit = s.get("Type8", {}).get("Top Hot", {}).get("cleared", False)
    print(f"=> Top Hot cleared: {hit} -> {'PASS' if hit else 'FAIL'}")
    ok &= hit

    print("\n### POSITIONAL CONTROL (Type1, 100 draws, first digit always 7): expect 'Ball Frequency' to clear")
    pos = [[7] + [int(x) for x in rng.integers(0, 10, 2)] for _ in range(100)]
    s = run_validation({"Type1": pos})
    hit = s.get("Type1", {}).get("Ball Frequency", {}).get("cleared", False)
    print(f"=> Ball Frequency cleared: {hit} -> {'PASS' if hit else 'FAIL'}")
    ok &= hit

    print("\n### FINALIZE CONTROL: duplicates and out-of-range values become a legal ticket")
    f = finalize_pick([14, 34, 34, 41, 41, 54], TYPE_CONFIG["Type8"], list(range(1, 59)))
    g = finalize_pick([12, -3, 4], TYPE_CONFIG["Type1"], [5, 6])
    good = (len(set(f)) == 6 and f == sorted(f) and g == [9, 0, 4])
    print(f"=> {f} / {g} -> {'PASS' if good else 'FAIL'}")
    ok &= good

    MAX_TRIALS = saved
    print(f"\nSELFTEST {'PASS' if ok else 'FAIL'}")
    return ok


