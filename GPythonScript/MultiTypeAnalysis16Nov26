def as_dict(draws):
    return {f"SET_{i+1}": list(d) for i, d in enumerate(draws)}

def walk_forward(type_name, draws):
    """Predict draw t from draws[:t] only, score against draws[t]."""
    cfg = TYPE_CONFIG[type_name]
    start = max(MIN_HISTORY, len(draws) - MAX_TRIALS)
    hits, failures = defaultdict(list), 0
    for t in range(start, len(draws)):
        try:
            with contextlib.redirect_stdout(io.StringIO()):
                preds = analyze_type(type_name, as_dict(draws[:t]))
        except Exception as e:
            failures += 1
            continue
        for m, p in preds.items():
            hits[m].append(score_pick(p, draws[t], cfg))
    return hits, failures

def run_validation(histories):
    print("\n" + "=" * 70)
    print("WALK-FORWARD VALIDATION vs RANDOM BASELINE (all types)")
    print("=" * 70)
    rows = []
    for tn, draws in histories.items():
        cfg = TYPE_CONFIG[tn]
        n_trials_possible = max(0, len(draws) - MIN_HISTORY)
        if n_trials_possible < TRIAL_FLOOR:
            print(f"{tn}: only {len(draws)} draws -> {n_trials_possible} trials "
                  f"(need {MIN_HISTORY + TRIAL_FLOOR}+ draws). Too few to test. "
                  f"Treat this type's picks as untested.")
            continue
        print(f"{tn}: backtesting {min(n_trials_possible, MAX_TRIALS)} trials ...", flush=True)
        hits, fails = walk_forward(tn, draws)
        if fails:
            print(f"  WARNING {tn}: {fails} trial(s) crashed and were skipped")
        pk = null_distribution(cfg)
        for m, h in hits.items():
            rows.append({"type": tn, "method": m, "trials": len(h), "total": sum(h),
                         "avg": sum(h) / len(h) if h else 0.0,
                         "null_avg": float((pk * np.arange(len(pk))).sum()),
                         "best": max(h, default=0),
                         "raw_p": p_total_at_least(sum(h), len(h), pk) if h else 1.0})
    if not rows:
        return {}
    adj = bh_adjust(np.array([r["raw_p"] for r in rows]))
    for r, a in zip(rows, adj):
        r["bh_p"] = float(a)
        r["cleared"] = r["bh_p"] < ALPHA and r["trials"] >= TRIAL_FLOOR
    print(f"\nTests in this run: {len(rows)} (type x method). BH correction across all of them.")
    out = defaultdict(dict)
    for tn in histories:
        tr = sorted([r for r in rows if r["type"] == tn], key=lambda r: r["raw_p"])
        if not tr:
            continue
        print(f"\n--- {tn} ({TYPE_CONFIG[tn]['name']}) | random ticket avg {tr[0]['null_avg']:.3f} ---")
        print(f"{'method':<22} {'trials':>6} {'avg':>6} {'best':>4} {'raw_p':>7} {'BH_p':>7}  verdict")
        for r in tr:
            v = "CLEARED (past data only)" if r["cleared"] else "no edge"
            print(f"{r['method']:<22} {r['trials']:>6} {r['avg']:>6.3f} {r['best']:>4} {r['raw_p']:>7.3f} {r['bh_p']:>7.3f}  {v}")
            out[tn][r["method"]] = r
    return out

def find_best(type_name, final_picks, stats):
    """New rule: only a method that cleared BH can be 'best'. Otherwise: no edge."""
    cfg = TYPE_CONFIG[type_name]
    st = stats.get(type_name, {})
    cleared = sorted([m for m, r in st.items() if r["cleared"]], key=lambda m: -st[m]["avg"])
    print(f"\n### {type_name} ({cfg['name']}) - SELECTION")
    if not st:
        print("UNTESTED: not enough history to backtest. Every pick below is unvalidated.")
    elif cleared:
        b = cleared[0]
        print(f"Best validated method: {b} -> {final_picks[b]}  "
              f"(avg {st[b]['avg']:.2f} vs {st[b]['null_avg']:.2f}, BH_p {st[b]['bh_p']:.3f})")
        print("This describes past data. It does not make the next draw more likely to match.")
    else:
        print("NO EDGE: no method beat a random ticket after correction. All picks below have equal odds.")
    if not cfg["positional"]:
        print("Popularity flags (affect jackpot sharing only, not odds):")
    for m, p in final_picks.items():
        tag = f"avg {st[m]['avg']:.2f}, BH_p {st[m]['bh_p']:.2f}" if m in st else "untested"
        print(f"  {m:<22} {p}  [{tag}]  popularity: {popularity_flags(p, cfg)}")


