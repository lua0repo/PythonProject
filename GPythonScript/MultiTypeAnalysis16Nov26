class CustomLinearRegression:
    def __init__(self):
        self.slope = 0
        self.intercept = 0

    def fit(self, X, y):
        # FIX: X used to be shape (n,1) and y shape (n,), so numpy broadcast
        # them into an n x n grid. ss_xy then always summed to 0 -> slope was
        # ALWAYS 0 and every "regression" just returned the average.
        X = np.array(X, dtype=float).flatten()
        y = np.array(y, dtype=float).flatten()
        mean_x = np.mean(X)
        mean_y = np.mean(y)
        ss_xy = np.sum((X - mean_x) * (y - mean_y))
        ss_xx = np.sum((X - mean_x) ** 2)
        self.slope = ss_xy / ss_xx if ss_xx != 0 else 0
        self.intercept = mean_y - self.slope * mean_x

    def predict(self, X_new):
        X_new = np.array(X_new, dtype=float).flatten()
        preds = self.intercept + self.slope * X_new
        if len(preds) == 1:
            return float(preds[0])
        return preds.tolist()

class AdaptiveRegimeEngine:
    def __init__(self, window=15, n_balls=6):
        self.window = window
        self.n_balls = n_balls
        self.balls = [f'Ball_{i+1}' for i in range(n_balls)]
        self.alpha = 0.25
        self.beta = 0.35
        self.gamma = 0.40
        self.W = np.array([1.0/n_balls] * n_balls)
        self.v_shock = np.vectorize(self._get_shock_intensity)

    def _get_shock_intensity(self, val):
        abs_val = abs(val)
        if abs_val <= 5: return 0.1
        elif 6 <= abs_val <= 12: return 0.4
        else: return 1.0

    def _update_weights(self, df_window):
        E = df_window.var().fillna(0).values
        S_count = self.v_shock(df_window.values).mean(axis=0)
        total_abs_move = df_window.abs().sum(axis=1)
        R = df_window.apply(lambda x: x.corr(total_abs_move)).fillna(0).values
        E_norm = E / (E.max() + 1e-8)
        S_norm = S_count / (S_count.max() + 1e-8)
        R_norm = R / (np.abs(R).max() + 1e-8)
        W_new = self.W * (1 + self.alpha * E_norm + self.beta * S_norm + self.gamma * R_norm)
        self.W = W_new / W_new.sum()
        return self.W

    def _calculate_rvi(self, df_window):
        V = df_window.abs().mean().values
        S = self.v_shock(df_window.values).mean(axis=0)
        return np.sum(self.W * (V + 2.5 * S))

    def _calculate_shock_prob(self, df_window, rvi):
        S = self.v_shock(df_window.values).mean(axis=0)
        p_shock = np.sum(self.W * S)
        volatility_bias = rvi / 10.0
        return min(p_shock * (1 + volatility_bias), 1.0)

    def _learn_causality(self, df_window):
        couplings = {}
        for i, b_i in enumerate(self.balls):
            for j, b_j in enumerate(self.balls):
                if i != j:
                    corr = df_window[b_i].iloc[:-1].corr(df_window[b_j].iloc[1:])
                    if not np.isnan(corr):
                        couplings[(b_i, b_j)] = abs(corr)
        return sorted(couplings.items(), key=lambda x: x[1], reverse=True)[:3]

    def _forecast(self, df_window, causality_graph):
        baseline = -df_window.mean().values
        bias_correction = -np.sign(baseline) * (df_window.abs().mean().values * 0.5)
        propagation = np.zeros(self.n_balls)
        last_row = df_window.iloc[-1].values
        for (b_i, b_j), strength in causality_graph:
            j_idx = self.balls.index(b_j)
            i_idx = self.balls.index(b_i)
            propagation[j_idx] += last_row[i_idx] * strength * 0.3
        return np.round(baseline + bias_correction + propagation, 1)

    def run_analysis(self, true_diff_df):
        df_window = true_diff_df.tail(self.window).copy()
        weights = self._update_weights(df_window)
        rvi = self._calculate_rvi(df_window)

        if rvi >= 9.0: regime = "🔴 SHOCK CYCLE"
        elif rvi >= 6.0: regime = "🟠 MEAN REVERSION"
        elif rvi >= 3.0: regime = "🟡 TRANSITION"
        else: regime = "🟢 CALM"

        p_shock = self._calculate_shock_prob(df_window, rvi)
        shock_band = "CRITICAL" if p_shock >= 0.8 else ("ELEVATED" if p_shock >= 0.5 else "NORMAL")

        last_deltas = true_diff_df.iloc[-1].values
        shock_contribs = weights * last_deltas
        heatmap_ranks = np.argsort(np.abs(shock_contribs))[::-1]

        max_delta_idx = np.argmax(np.abs(last_deltas))
        justification = f"[Multi-node expansion: {self.balls[max_delta_idx]} breaching threshold with Δ={last_deltas[max_delta_idx]:.1f}. RVI driven to {rvi:.2f}.]"
        causality = self._learn_causality(df_window)

        if regime == "🔴 SHOCK CYCLE": probs = {"SHOCK": 0.30, "MEAN REVERSION": 0.50, "TRANSITION": 0.15, "CALM": 0.05}
        elif regime == "🟠 MEAN REVERSION": probs = {"SHOCK": 0.10, "MEAN REVERSION": 0.40, "TRANSITION": 0.35, "CALM": 0.15}
        elif regime == "🟡 TRANSITION": probs = {"SHOCK": 0.25, "MEAN REVERSION": 0.15, "TRANSITION": 0.40, "CALM": 0.20}
        else: probs = {"SHOCK": 0.05, "MEAN REVERSION": 0.10, "TRANSITION": 0.25, "CALM": 0.60}

        next_regime = max(probs, key=probs.get)
        next_regime_emoji = {"SHOCK": "🔴", "MEAN REVERSION": "🟠", "TRANSITION": "🟡", "CALM": "🟢"}
        forecast = self._forecast(df_window, causality)

        print("\n" + "="*50)
        print("🧠 ADAPTIVE REGIME & SHOCK ANALYSIS v2.0  (descriptive - not validated)")
        print("="*50)
        print("## 1. UPDATED WEIGHTS")
        for i, b in enumerate(self.balls): print(f"* {b}: {weights[i]:.3f}")
        print(f"*(ΣW = {weights.sum():.3f}*)\n")
        print("## 2. RVI SCORE")
        print(f"* Value: {rvi:.2f}")
        print(f"* Regime State: {regime}\n")
        print("## 3. SHOCK PROBABILITY")
        print(f"* Value: {p_shock:.3f}")
        print(f"* Band: {shock_band}\n")
        print("## 4. SHOCK HEATMAP")
        for rank, idx in enumerate(heatmap_ranks):
            print(f"* Rank {rank+1}: {self.balls[idx]} (Contribution: {shock_contribs[idx]:.3f} | Δ: {last_deltas[idx]:.1f})")
        print()
        print("## 5. REGIME CLASSIFICATION")
        print(f"* Label: {regime}")
        print(f"* Learned Justification Signal: {justification}\n")
        print("## 6. CROSS-BALL LEARNED GRAPH")
        for (b_i, b_j), strength in causality:
            print(f"* Strongest Coupling: {b_i} → {b_j} (λ: {strength:.2f})")
        print("* Propagation Directionality: Sequential cascade derived from lead-lag correlation.\n")
        print("## 7. NEXT REGIME DISTRIBUTION")
        for state, prob in probs.items(): print(f"* {state}: {int(prob*100)}%")
        print(f"*(ΣP = 100%)*\n")
        print("## 8. FORECAST VECTOR (LEARNED)")
        for i, b in enumerate(self.balls): print(f"* {b}: {forecast[i]:.1f}")
        print("*(Bias Correction: Active mean-reversion pull. Propagation Effect: Lead-lag applied)*\n")
        print("## 9. FINAL TRANSITION")
        print(f"{regime} → {next_regime_emoji[next_regime]} {next_regime.upper()}")


