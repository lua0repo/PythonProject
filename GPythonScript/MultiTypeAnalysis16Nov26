def validate_draws(type_name, draws):
    cfg = TYPE_CONFIG[type_name]
    problems, seen = [], {}
    for i, d in enumerate(draws, 1):
        if len(d) != cfg["n_slots"] or not all(cfg["min_val"] <= n <= cfg["max_val"] for n in d):
            problems.append(f"SET_{i}: wrong length or out of range {d}")
        elif not cfg["positional"] and len(set(d)) != len(d):
            problems.append(f"SET_{i}: repeated number in a pool draw {d}")
        key = tuple(d) if cfg["positional"] else tuple(sorted(d))
        if key in seen:   # flagged, never removed
            problems.append(f"SET_{i}: same as SET_{seen[key]} {list(key)} - check official result")
        seen.setdefault(key, i)
    return problems

def finalize_pick(pred, cfg, fallback_rank):
    """Make any method's output a legal ticket for this game.
    Pool: unique, in range, filled from fallback_rank, sorted.
    Positional: clipped to range, padded from fallback_rank, order kept."""
    n, lo, hi = cfg["n_slots"], cfg["min_val"], cfg["max_val"]
    vals = []
    for v in (pred or []):
        try:
            vals.append(int(round(float(v))))
        except (TypeError, ValueError):
            continue
    vals = [min(hi, max(lo, v)) for v in vals]
    if cfg["positional"]:
        vals = vals[:n]
        fill = [v for v in fallback_rank]
        i = 0
        while len(vals) < n:
            vals.append(fill[i % len(fill)] if fill else lo)
            i += 1
        return vals
    out = list(dict.fromkeys(vals))[:n]
    for v in fallback_rank:
        if len(out) >= n:
            break
        if v not in out:
            out.append(v)
    return sorted(out)

def score_pick(pick, actual, cfg):
    if cfg["positional"]:
        return sum(1 for a, b in zip(pick, actual) if a == b)
    return len(set(pick) & set(actual))

def null_distribution(cfg):
    """Exact P(k matches) for one random ticket."""
    n = cfg["n_slots"]
    if cfg["positional"]:
        p = 1.0 / (cfg["max_val"] - cfg["min_val"] + 1)
        return np.array([n_choose_k(n, k) * p**k * (1 - p)**(n - k) for k in range(n + 1)])
    N = cfg["max_val"] - cfg["min_val"] + 1
    return np.array([n_choose_k(n, k) * n_choose_k(N - n, n - k) / n_choose_k(N, n) for k in range(n + 1)])

def p_total_at_least(total, n_trials, pk):
    d = np.array([1.0])
    for _ in range(n_trials):
        d = np.convolve(d, pk)
    return float(d[total:].sum())

def bh_adjust(pvals):
    m = len(pvals)
    if m == 0:
        return np.array([])
    order = np.argsort(pvals)
    adj = np.empty(m)
    prev = 1.0
    for rank in range(m - 1, -1, -1):
        j = order[rank]
        prev = min(prev, pvals[j] * m / (rank + 1))
        adj[j] = prev
    return adj

def popularity_flags(pick, cfg):
    """Pool games only. Does NOT change win odds; flags jackpot-sharing risk."""
    if cfg["positional"]:
        return "n/a"
    flags = []
    low = sum(n <= 31 for n in pick)
    if low >= 5: flags.append(f"{low}/6 in 1-31")
    runs = sum(1 for a, b in zip(pick, pick[1:]) if b - a == 1)
    if runs >= 2: flags.append(f"{runs} consecutive pairs")
    if len({b - a for a, b in zip(pick, pick[1:])}) == 1: flags.append("arithmetic pattern")
    return "; ".join(flags) or "none"


