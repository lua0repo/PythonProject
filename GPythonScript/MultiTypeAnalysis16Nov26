    def ml_predict_combination(pair_counter):
        # Same math as before (regression on each pair's cumulative count),
        # computed with numpy so long histories stay fast.
        times = np.arange(1, num_sets + 1, dtype=float)
        pair_list = list(pair_counter.keys())
        if not pair_list:
            return [min_number] * n_balls
        idx = {p: i for i, p in enumerate(pair_list)}
        pres = np.zeros((len(pair_list), num_sets))
        for t, s in enumerate(historical_data.values()):
            for p in itertools.combinations(sorted(s), 2):
                if p in idx:
                    pres[idx[p], t] = 1
        cum = np.cumsum(pres, axis=1)
        mx = times.mean()
        ssxx = ((times - mx) ** 2).sum()
        slope = ((times - mx) * (cum - cum.mean(axis=1, keepdims=True))).sum(axis=1) / ssxx if ssxx else np.zeros(len(pair_list))
        nxt = cum.mean(axis=1) - slope * mx + slope * (num_sets + 1)
        order = sorted(range(len(pair_list)), key=lambda i: nxt[i], reverse=True)[:n_balls // 2]
        common_nums = [num for i in order for num in pair_list[i]]
        predicted = list(set(common_nums))
        if not DISABLE_SORTING:
            predicted = sorted(predicted)
        predicted = predicted[:n_balls]
        while len(predicted) < n_balls:
            predicted.append(predicted[-1] + 1 if predicted else min_number)
        return predicted

